# Umgebung der Entwicklungsinstanz — nach /etc/rennspiel-dev.env kopieren.
#
# Der Live-Server wird davon nicht berührt: er hat seine eigene Umgebung, seine
# eigenen Ports und sein eigenes Verzeichnis. Diese Datei gehört allein der
# Instanz mit dem Kennzeichen T.

# Das erste Zeichen jedes Lobbycodes. H ist Helsinki live, D ist Hamburg live.
# Muss zu RACE_SERVER_TAG auf der Clientseite passen, sonst weist derselbe
# Client die Codes ab, die dieser Server erzeugt.
RACE_SERVER_TAG=T

# Eigene Ports. Der Live-Server in Helsinki hört auf TCP 7777 und 7778 sowie
# UDP 7777 — die bleiben unberührt.
RACE_TCP_PORTS=7878
RACE_UDP_PORT=7877

# Klein halten: das hier ist eine Werkbank, kein Betrieb. Die Grenzen aus
# Block H gelten auch hier, nur mit kleinen Werten — der Dev-Server ist nicht
# gehärtet für das, was du auf ihm ausprobieren wirst.
RACE_MAX_LOBBIES=5
RACE_MAX_CONN_TOTAL=20
RACE_MAX_LOBBIES_PER_IP=5
